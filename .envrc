# shellcheck shell=bash
#
# Point the Dagger CLI/SDK at the shared engine on this host (tc: the
# dagger/dagger-engine pod, unix socket), so `make test` / `dagger call` run on
# the same engine version CI boots (DAGGER_ENGINE_VERSION in ci.yml; see
# otelhouse#33). DAGGER_ENGINE is Dagger 1.0's selector; it replaced the
# deprecated _EXPERIMENTAL_DAGGER_RUNNER_HOST.
#
# This replaces the old global /etc/profile.d/dagger.sh, which exported the same
# variable for every login shell. That file was removed so the runner-host
# config travels per-project via direnv instead of polluting every shell.
export DAGGER_ENGINE="unix:///run/dagger/engine.sock"
